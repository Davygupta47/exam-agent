PORT=5000
NODE_ENV=development

# Database Configuration (supports normal local Postgres or Docker Postgres)
# If using DATABASE_URL:
# DATABASE_URL=postgresql://exam_admin:exam_pass_123@localhost:5432/exam_management
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=exam_management

# Authentication
JWT_SECRET=your-very-secure-random-jwt-secret-key-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:3000
